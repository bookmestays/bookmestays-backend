# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of this API (used in webhooks / channel manager endpoints)
API_URL=http://localhost:4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://admin.localhost:3000,http://partner.localhost:3000
WEB_URL=http://localhost:3000

# ─── Database (Neon now, AWS RDS Postgres later — only this URL changes) ──
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Auth ─────────────────────────────────────────────────
# Long random strings: `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=365
# Used to encrypt sensitive values at rest (bank account numbers, channel manager credentials)
ENCRYPTION_KEY=change-me-32-bytes-hex
# First super admin (created by `bun run seed`)
SEED_ADMIN_EMAIL=admin@bookmestays.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# ─── AWS S3 (media) ───────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# CloudFront (or bucket) public base URL, e.g. https://dxxxx.cloudfront.net
MEDIA_CDN_URL=

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX account number (for payouts / adjustments)
RAZORPAYX_ACCOUNT_NUMBER=
# true = split every payment to the hotel's linked account (Razorpay Route), held until settlement
RAZORPAY_ROUTE_ENABLED=true

# ─── Notifications ────────────────────────────────────────
# console | smtp (console just logs, useful in development)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BookMeStays <no-reply@bookmestays.com>"

# ─── WhatsApp (AiSensy) ───────────────────────────────────
# console | aisensy  (console just logs, useful in development)
WHATSAPP_PROVIDER=console
# AiSensy dashboard → Manage → API Key  (a long JWT token)
AISENSY_API_KEY=
# Leave as-is unless AiSensy gives you a different base URL
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_SENDER_NAME=BookMeStays
# true if your OTP (authentication) template has a "Copy code" button
AISENSY_OTP_COPY_CODE_BUTTON=true
# API Campaign names you create in AiSensy (Campaigns → API campaign → Set Live).
# Each must point at an APPROVED template. Names must match these values exactly.
#   OTP template body        : {{1}} = the 6-digit code
#   Booking-guest body       : {{1}} name {{2}} property {{3}} code {{4}} check-in {{5}} check-out {{6}} amount
#   Booking-partner body     : {{1}} property {{2}} code {{3}} guest {{4}} check-in {{5}} check-out {{6}} rooms {{7}} payout
#   Cancelled-guest body     : {{1}} name {{2}} code {{3}} property {{4}} refund line
#   Cancelled-partner body   : {{1}} code {{2}} guest {{3}} property {{4}} check-in {{5}} check-out
AISENSY_CAMPAIGN_OTP=
AISENSY_CAMPAIGN_BOOKING_GUEST=
AISENSY_CAMPAIGN_BOOKING_PARTNER=
AISENSY_CAMPAIGN_BOOKING_CANCELLED_GUEST=
AISENSY_CAMPAIGN_BOOKING_CANCELLED_PARTNER=

# ─── Channel managers ─────────────────────────────────────
# Credentials each channel manager uses to call OUR channel API (issued by us, shared with them)
CM_AXISROOMS_USERNAME=
CM_AXISROOMS_PASSWORD=
CM_EZEE_USERNAME=
CM_EZEE_PASSWORD=
CM_STAAH_USERNAME=
CM_STAAH_PASSWORD=
CM_SITEMINDER_USERNAME=
CM_SITEMINDER_PASSWORD=
CM_ASIATECH_USERNAME=
CM_ASIATECH_PASSWORD=
# Endpoints + credentials WE use to push reservations to them (given by each channel manager after partnership)
CM_AXISROOMS_ENDPOINT=
CM_AXISROOMS_API_KEY=
CM_EZEE_ENDPOINT=
CM_EZEE_API_KEY=
CM_STAAH_ENDPOINT=
CM_STAAH_API_KEY=
CM_SITEMINDER_ENDPOINT=
CM_SITEMINDER_API_KEY=
CM_ASIATECH_ENDPOINT=
CM_ASIATECH_API_KEY=
# Our identifier as a channel inside the channel managers' systems
CM_CHANNEL_CODE=BOOKMESTAYS
