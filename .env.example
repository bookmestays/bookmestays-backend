# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of this API (used in webhooks / channel manager endpoints)
API_URL=http://localhost:4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://admin.localhost:3000,http://partner.localhost:3000
WEB_URL=http://localhost:3000

# ─── Database (Neon now, AWS RDS Postgres later — only this URL changes) ──
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Auth ─────────────────────────────────────────────────
# Long random strings: `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Used to encrypt sensitive values at rest (bank account numbers, channel manager credentials)
ENCRYPTION_KEY=change-me-32-bytes-hex
# First super admin (created by `bun run seed`)
SEED_ADMIN_EMAIL=admin@bookmestays.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# ─── AWS S3 (media) ───────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# CloudFront (or bucket) public base URL, e.g. https://dxxxx.cloudfront.net
MEDIA_CDN_URL=

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX account number (for payouts / adjustments)
RAZORPAYX_ACCOUNT_NUMBER=
# true = split every payment to the hotel's linked account (Razorpay Route), held until settlement
RAZORPAY_ROUTE_ENABLED=true

# ─── Notifications ────────────────────────────────────────
# console | smtp | msg91 (console just logs, useful in development)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BookMeStays <no-reply@bookmestays.com>"
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ─── Channel managers ─────────────────────────────────────
# Credentials each channel manager uses to call OUR channel API (issued by us, shared with them)
CM_AXISROOMS_USERNAME=
CM_AXISROOMS_PASSWORD=
CM_EZEE_USERNAME=
CM_EZEE_PASSWORD=
CM_STAAH_USERNAME=
CM_STAAH_PASSWORD=
CM_SITEMINDER_USERNAME=
CM_SITEMINDER_PASSWORD=
# Endpoints + credentials WE use to push reservations to them (given by each channel manager after partnership)
CM_AXISROOMS_ENDPOINT=
CM_AXISROOMS_API_KEY=
CM_EZEE_ENDPOINT=
CM_EZEE_API_KEY=
CM_STAAH_ENDPOINT=
CM_STAAH_API_KEY=
CM_SITEMINDER_ENDPOINT=
CM_SITEMINDER_API_KEY=
# Our identifier as a channel inside the channel managers' systems
CM_CHANNEL_CODE=BOOKMESTAYS
